-- DROP TABLE node;

CREATE TABLE node (
    node_id BigInt PRIMARY KEY, 
    lat Float NOT NULL,
    lon Float NOT NULL,
    geom_node GEOMETRY(Point, 4326)  
);

-- DROP TABLE edge;

CREATE TABLE edge (
    edge_id BigInt PRIMARY KEY,
    u BigInt REFERENCES node(node_id), 
    v BigInt REFERENCES node(node_id), 
    length Float NOT NULL,
    is_indoor Boolean DEFAULT FALSE,
    geom_edge GEOMETRY(LineString, 4326)
);

-- DROP TABLE noise_sensor;

CREATE TABLE noise_sensor (
    device_id VARCHAR(50) PRIMARY KEY,
    geom_sensor GEOMETRY(Point, 4326),  
    current_db FLOAT,
    last_updated Timestamp
);

-- DROP TABLE Edge_Weight;

CREATE TABLE Edge_Weight (
    weight_id SERIAL PRIMARY KEY,
    edge_id BigInt REFERENCES Edge(edge_id) UNIQUE, 
    final_cost FLOAT,
    observation_time Timestamp, 
    noise_db FLOAT,
    is_high_noise boolean
);

--DROP TABLE pedestrian_sensor;

CREATE TABLE pedestrian_sensor (
    location_id BigInt PRIMARY KEY,
    geom_sensor GEOMETRY(Point, 4326),  
    current_count BigInt,
    observation_time Timestamp
);

-- DROP TABLE Safe_Space;

CREATE TABLE Safe_Space (
    safe_space_id SERIAL PRIMARY KEY,
    geom_safe_space GEOMETRY(Point, 4326),
    sub_theme VARCHAR(100),
    feature_name VARCHAR(255) NOT NULL
);